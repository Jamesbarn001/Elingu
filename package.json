{
  "name": "elingu-starter",
  "version": "5.0.0",
  "description": "Elingu — Multi-curriculum Socratic AI Tutor & Institutional Portal (Kenyan CBE & British IGCSE).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server.js --watch-path=public --watch-path=studentStore.js --watch-path=parentStore.js --watch-path=teacherStore.js --watch-path=teacherRoutes.js --watch-path=adminStore.js --watch-path=adminRoutes.js --watch-path=constitution.js --watch-path=curriculumContext.js server.js",
    "test": "node tests/runner.js",
    "db:inspect": "node db/inspect.js",
    "db:migrate": "node db/migrate.js",
    "db:reset": "node db/reset.js",
    "db:delete": "node db/delete.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/genai": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "groq-sdk": "^1.3.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "resend": "^6.26.0"
  }
}
