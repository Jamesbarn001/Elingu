# ============================================================
# ELINGU — ENVIRONMENT VARIABLE REFERENCE
# Copy this to .env and fill in your keys. NEVER commit .env to git.
# ============================================================

# ── GEMINI (DEFAULT — FREE TIER) ─────────────────────────────
# Get a free key at: https://aistudio.google.com
GOOGLE_API_KEY=get_from_aistudio.google.com

# Model to use: gemini-2.0-flash (free tier)
GEMINI_MODEL=gemini-2.0-flash

# ── PROVIDER SELECTION ───────────────────────────────────────
# Options: gemini | groq | anthropic
MODEL_PROVIDER=gemini

# ── GROQ (LLAMA 3.3 — FREE FALLBACK) ─────────────────────────
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# ── ANTHROPIC (CLAUDE — PAID, BEST QUALITY) ───────────────────
# Get your key at: https://console.anthropic.com
# Set MODEL_PROVIDER=anthropic to activate Claude Haiku as default.
# Claude Sonnet is auto-activated on emotional distress detection regardless of provider.
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── LEGACY SUPPORT (old config) ──────────────────────────────
# AI_PROVIDER=groq (still works if MODEL_PROVIDER is not set)

# ── SECURITY & RBAC ───────────────────────────────────────────
# Optional shared secret to protect /api/analytics/dashboard
ADMIN_SECRET=your_admin_secret_key_here

PORT=3000

# ── EMAIL NOTIFICATIONS (CHOOSE EITHER GMAIL SMTP OR RESEND) ─────────
# OPTION 1: 100% Free Gmail SMTP via Nodemailer (No custom domain needed!)
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password (name it "Elingu") and paste the 16 characters below:
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# OPTION 2: Resend API (Free 3,000 emails/mo, requires verified domain for external parents)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev
RESEND_FROM_NAME=Elingu

# ── PRODUCTION DATABASE (POSTGRESQL) ───────────────────────────
# Leave commented out to use zero-config embedded SQLite (data/elingu.sqlite).
# To connect to a cloud PostgreSQL instance (Supabase, Neon, Railway, AWS, Render):
# Paste your connection string here:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Set to 'true' if connecting to cloud-hosted databases with SSL:
# DATABASE_SSL=true


# ── PAYMENT GATEWAYS (SAFARICOM DARAJA & PAYSTACK) ────────────
# Set to 'production' for live M-Pesa, or 'sandbox' for test mode
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_BUSINESS_SHORTCODE=174379
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_CALLBACK_URL=http://localhost:3000/api/payment/mpesa-callback
# Long random string. Added to the callback URL we register so forged callbacks are rejected.
DARAJA_CALLBACK_SECRET=

# Set to 'live' for real payments, or 'test' for Paystack sandbox
PAYSTACK_ENVIRONMENT=test
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public
PAYSTACK_SECRET_KEY=sk_test_elingu_demo_secret_2026

# ── ENCRYPTION OF PERSONAL DATA AT REST ───────────────────────
# Generate once with:  node scripts/encrypt_data.js --generate-key
# Keep a copy somewhere safe and SEPARATE (password manager). If it is lost, encrypted data cannot be recovered.
# Never commit it. Then encrypt existing data with:  node scripts/encrypt_data.js --apply
ELINGU_DATA_KEY=
# For key rotation: put the old key(s) here (comma separated) while the new key is in ELINGU_DATA_KEY, then run --apply.
ELINGU_DATA_KEY_PREVIOUS=
# Set to true in production to refuse to start without a valid key.
ELINGU_REQUIRE_ENCRYPTION=

# Public contact address shown on /privacy for data requests (optional)
PRIVACY_CONTACT_EMAIL=
