# ============================================================
# ELINGU — .gitignore
# SECURITY: Any file listed here will NEVER be pushed to GitHub.
# ============================================================

# ── SECRETS & ENVIRONMENT ────────────────────────────────────
# .env is the ONLY file where real keys live. It is NEVER committed.
# .env.example is safe to commit — it contains ONLY placeholder text.
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# ── DEPENDENCIES ─────────────────────────────────────────────
node_modules/
package-lock.json

# ── LOGS ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── OS FILES ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── EDITOR / IDE ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── BUILD ARTIFACTS / SCRATCH ────────────────────────────────
dist/
build/
.cache/
scratch/
.agents/

# ── DATA FENCE: COMPLETE EXCLUSION OF ALL APPLICATION & USER DATA ──
# Absolutely NO user, student, parent, teacher, school, or admin data crosses to git!
data/
!data/schools.json.template
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sql
*.dump
*.csv
backups/
backup*/
dump*/

# ── TEST EXHAUST, TRACES & AUDIT LOGS ────────────────────────
docs/teamwork_exhaust/tests/
docs/teamwork_exhaust/backups/
docs/teamwork_exhaust/*.log
docs/teamwork_exhaust/*.json

# ── PRESENTATION DECKS & OFFICE LOCK FILES ───────────────────
*.pptx
~$*.pptx



